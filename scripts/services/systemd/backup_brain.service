[Unit]
Description=BackupBrain
Requires=mongod.service
Requires=meilisearch.service
After=mongod.service
After=meilisearch.service
# Start delayed_job workers alongside this service; stopping this also stops them (via PartOf).
# Add or remove instances here to change the worker count.
Wants=backup_brain_delayed_job@1.service backup_brain_delayed_job@2.service
After=backup_brain_delayed_job@1.service backup_brain_delayed_job@2.service

[Service]
User=YOUR_USERNAME
Group=USER_GROUP
Environment=RAILS_ENV=development
# production.rb already defaults this to true (puma serves public/ itself, there is
# no reverse proxy). Set it to false here only if you put nginx or similar in front.
Environment=RAILS_SERVE_STATIC_FILES=true
ExecStart=/bin/bash -lc /path/to/backup_brain/serve
ExecReload=/bin/bash -lc /path/to/backup_brain/serve
Restart=on-failure
# serve exits 78 on a config problem (missing .env value, etc.). Without a pause
# systemd would hit its start rate limit in seconds and give up.
RestartSec=10

[Install]
WantedBy=multi-user.target
