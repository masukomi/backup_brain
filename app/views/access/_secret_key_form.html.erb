<%= render partial: "shared/errors_row", locals: {thing: secret_key} %>
<%= form_with(model: secret_key, url: secret_keys_path) do |form| %>
  <div class="container">
    <div class="row">
      <div class="col-2">
        <%= form.label :name, t("access.secret_keys.name_label"), class: "col-form-label" %>
      </div>
      <div class="col-9">
        <%= form.text_field :name, class: "form-control" %>
      </div>
    </div>
    <div class="row">
      <div class="col-2">
        <%= label_tag "secret_key_permissions", t("access.secret_keys.permission_label"), class: "col-form-label" %>
      </div>
      <div class="col-9">
        <%= select_tag "secret_key[permissions][]",
              options_for_select(
                SecretKey::VALID_PERMISSIONS.map { |p| [t("access.secret_keys.permissions.#{p}"), p] },
                secret_key.permissions
              ),
              id: "secret_key_permissions",
              class: "form-select" %>
      </div>
    </div>
    <div class="row">
      <div class="col">
        <%= form.submit class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>
