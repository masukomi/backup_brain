<div tabindex="0" id="<%= dom_id secret_key %>" class="container bookmark-list-item">
  <div class="row">
    <div class="col-8">
      <div class="row">
        <div class="col">
          <%= link_to secret_key.name, show_secret_key_path(secret_key) %>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="action-icons">
        <div class="action-icon">
          <%= icon_link("edit", rename_secret_key_form_path(secret_key),
                        link_css: "inline-link-icon edit-link-icon",
                        text: t("access.secret_keys.rename_link"),
                        aria_hidden: true) %>
        </div>
        <div class="action-icon delete-action-icon">
          <%== link_to image_tag("/images/icons/delete.svg",
                                 class: "inline-link-icon delete-icon",
                                 "aria-hidden": true) + t("access.secret_keys.delete_link"),
                       secret_key_path(secret_key),
                       class: "inline-link-icon delete-link-icon",
                       data: {
                         turbo_method: :delete,
                         turbo_confirm: t("misc.are_you_sure")
                       } %>
        </div>
      </div>
    </div>
  </div>
</div>
