<div class="container">
  <div class="row">
    <div class="col">
      <heading><%= t("access.api_keys.created_heading") %></heading>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <p><strong><%= t("access.api_keys.copy_key_warning") %></strong></p>
      <pre><code><%= @new_key_value %></code></pre>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <%= link_to t("access.back_to_access"), access_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
