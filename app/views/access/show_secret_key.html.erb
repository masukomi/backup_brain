<div class="container">
  <div class="row">
    <div class="col">
      <heading><%= @secret_key.name %></heading>
    </div>
  </div>
  <div class="row">
    <div class="col-2">
      <%= t("access.secret_keys.permission_label") %>
    </div>
    <div class="col-9">
      <%= @secret_key.permissions.map { |p| t("access.secret_keys.permissions.#{p}") }.join(", ") %>
    </div>
  </div>
  <div class="row">
    <div class="col-2">
      <%= t("access.secret_keys.key_label") %>
    </div>
    <div class="col-9">
      <pre><code><%= @secret_key.key %></code></pre>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <%= link_to t("access.back_to_access"), access_path %>
    </div>
  </div>
</div>
