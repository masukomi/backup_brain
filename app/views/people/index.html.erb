<div class="container">
  <div class="row small-top-margin">
    <div class="col">
      <heading><%= t("people.list_heading") %></heading>
    </div>
    <% if current_user %>
      <div class="col-auto">
        <%= link_to t('people.add'), new_person_path, class: 'btn btn-primary compact-button' %>
      </div>
    <% end %>

  </div>
</div>

<% if @people_first_characters.empty? %>
  <div class="container">
    <div class="row">
      <div class="col">
        <%= t("people.no_people_message") %>
      </div>
    </div>
  </div>
<% else %>
  <div class="container">
    <div class="row">
      <div class="col">
        <nav class="pagy-bootstrap-nav" role="navigation">
        <ul class="pagination tag-admin-list">
        <% @people_first_characters.each do |char| %>
          <li class="page-item<% if @starting_with == char %> active<% end %>">
            <%= link_to(char, people_path(starting_with: char),
                class: "page-link tags-page-link"
                ) %>
          </li>
        <% end %>
        </ul>
      </div>
    </div>
  </div>
  <div class="container" id="people">
    <% @people.each do |person| %>
      <div class="row">
        <div class="col">
          <%= render person %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
