<div class="container">
  <div class="row">
    <div class="col">
      <heading><%= t("domain_triggers.list_heading") %></heading>
    </div>
  </div>
</div>

<% content_for :sidebar do %>
  <%= render partial: "shared/sidebar_page_actions_top" %>
  <div id="page-actions">
    <div class="container">
      <div class="row">
        <div class="col">
          <ul>
            <li><%= link_to t("domain_triggers.add"), new_domain_trigger_path,
                            class: "btn btn-primary compact-button" %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% if @domain_triggers.empty? %>
  <div class="container">
    <div class="row">
      <div class="col">
        <%= t("domain_triggers.no_triggers_message") %>
      </div>
    </div>
  </div>
<% else %>
  <div class="container" id="domain-triggers">
    <% @domain_triggers.each do |domain_trigger| %>
      <div class="row">
        <div class="col">
          <%= render domain_trigger %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
