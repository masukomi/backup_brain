<%= form_with(model: setting) do |form| %>

  <div class="container">
  <% if @setting_administration_enabled %>

    <div class="row">
      <div class="col-2">
        <%= form.label :lookup_key, style: "display: block" %>
      </div>
      <div class="col">
        <%= form.text_field :lookup_key, dir: "auto" %>
      </div>
    </div>

    <div class="row">
      <div class="col-2">
        <%= form.label :summary, style: "display: block" %>
      </div>
      <div class="col">
        <%= form.text_field :summary %>
      </div>
    </div>

    <div class="row">
      <div class="col-2">
        <%= form.label :description, style: "display: block" %>
      </div>
      <div class="col">
        <%= form.text_area :description,
            cols: 60,
            rows: text_area_rows(setting.description, minimum: 4),
            dir: "auto" %>
      </div>
    </div>

    <% else %>
    <div class="row metadata">
      <div class="col">
        <%= t('settings.lookup_key') %>
      </div>
      <div class="col">
        <code><%= setting.lookup_key %></code>
      </div>
    </div>

    <div class="row">
      <div class="col">
        <%= t('settings.summary') %>
      </div>
      <div class="col">
        <% summary = t("settings.details.#{setting.lookup_key}.summary") %>
        <%== ::Rendering::Markdown.instance.render(summary.present? ? summary : setting.summary) %>
      </div>
    </div>

    <div class="row">
      <div class="col">
        <%= t('settings.description') %>
      </div>
      <div class="col">
        <p>
          <% desc = t("settings.details.#{setting.lookup_key}.description") %>
          <%== ::Rendering::Markdown.instance.render(desc.present? ? desc : setting.description) %>
        </p>
      </div>
    </div>

    <% end %>

    <% display_as = setting.display_value_as %>
    <% inner = setting.inner_value %>

    <% if display_as.is_a?(Hash) %>
      <%# Hash type: one row per inner key %>
      <% display_as.each do |key, type| %>
        <% field_value = inner.is_a?(Hash) ? (inner[key] || inner[key.to_s]) : nil %>
        <div class="row">
          <div class="col">
            <label for="setting_value_<%= key %>"><%= key %></label>
          </div>
          <div class="col">
            <% if type == "boolean" %>
              <span class="form-check form-switch">
                <%= hidden_field_tag "setting[value][#{key}]", "false" %>
                <%= check_box_tag "setting[value][#{key}]", "true", field_value == true,
                    class: "bookmark-checkbox-field form-check-input toggle", role: "switch",
                    id: "setting_value_#{key}" %>
              </span>
            <% elsif type == "integer" %>
              <%= number_field_tag "setting[value][#{key}]", field_value,
                  id: "setting_value_#{key}" %>
            <% elsif type == "string" %>
              <%= text_field_tag "setting[value][#{key}]", field_value,
                  id: "setting_value_#{key}", dir: "auto" %>
            <% elsif type == "array" %>
              <div class="metadata"><%= t("settings.form.array_hint") %></div>
              <%= text_field_tag "setting[value][#{key}]", field_value&.join(", "),
                  id: "setting_value_#{key}", dir: "auto" %>
            <% elsif type == "text" %>
              <%= text_area_tag "setting[value][#{key}]", field_value,
                  id: "setting_value_#{key}",
                  cols: 60,
                  rows: text_area_rows(field_value, minimum: 4),
                  dir: "auto" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="row">
        <div class="col">
          <% if display_as == "boolean" %>
            <%= form.label :value,
                style: "display: block",
                "aria-label": t("settings.enable_disable_toggle_label") %>
          <% else %>
            <%= form.label :value, style: "display: block" %>
          <% end %>
        </div>
        <div class="<%= display_as == "boolean" ? "col-2" : "col" %>">
          <% if display_as == "boolean" %>
            <span class="form-check form-switch">
              <%= form.check_box :value,
                  {class: "bookmark-checkbox-field form-check-input toggle", role: "switch",
                   checked: inner == true},
                  "true", "false" %>
            </span>
          <% elsif display_as == "integer" %>
            <%= form.number_field :value, value: inner %>
          <% elsif display_as == "string" %>
            <%= form.text_field :value, value: inner, dir: "auto" %>
          <% elsif display_as == "array" %>
            <div class="metadata"><%= t("settings.form.array_hint") %></div>
            <%= form.text_field :value, value: inner&.join(", "), dir: "auto" %>
          <% else %>
            <%# "text" or any unknown type %>
            <%= form.text_area :value,
                value: inner,
                cols: 60,
                rows: text_area_rows(inner, minimum: 4),
                dir: "auto" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="row">
      <div class="col">
        <%= form.submit class: 'btn btn-primary' %>
      </div>
    </div>
  </div>
<% end %>
