<div class="container">
  <div class="row">
    <div class="col"><h3 class='stylized-header'>Settings</h3></div>
  </div>
  <% if @setting_administration_enabled %>
  <div class="row mini-nav-links">
    <div class="col">
      <%= link_to t('settings.create_link'), new_setting_path %>
    </div>
  </div>
  <% end %>
</div>
<div id="settings" class="container tableish">

  <% if @settings.count > 0 %>
    <% @settings.each do |setting| %>
      <div class="row">
        <div class="col-1">
          <%= icon_link("edit", edit_setting_path(setting),
              link_css: "inline-link-icon edit-link-icon",
              method: :put,
              text: nil) %>
        </div>
        <div class="col">
          <code><%= setting.lookup_key %></code>
          <br />
          <%= setting.summary %>
        </div>
      </div>
      <div class="row">
        <div class="col-1">&nbsp;</div>
        <div class="col">
          <%= t("settings.value") %> »
          <code><%=setting.inner_value %></code>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="row">
      <div class="col">
        <%== t('settings.no_settings_text') %>
      </div>
    </div>
  <% end %>
</div>
