<%# Note: this exists within a bootstrap 'col' %>
<% archive.media_objects.select(&:is_youtube?).each do |mo| %>
  <% embed_src = BackupBrain::YouTube.embed_url(mo.url)
    blur = mo.sensitive && ! bookmark.sensitive
  %>
  <% if embed_src %>
    <% embed_src += (embed_src.include?("?") ? "&" : "?") + "enablejsapi=1" %>
    <% if blur %>
      <sensitive>
    <% end %>
      <iframe id="yt-player-<%= mo._id %>"
              class="youtube-player-embed"
              width="560" height="315"
              src="<%= embed_src %>"
              frameborder="0"
              allowfullscreen></iframe>
    <% if blur %>
      </sensitive>
    <% end %>
  <% end %>
<% end %>
<archive>
<%= render_markdown(archive.string_data).html_safe %>
</archive>
<% transcribed_media = archive.media_objects.select { |mo| mo.transcription&.status == "completed" } %>
<% if transcribed_media.any? %>
  <% transcribed_media.each_with_index do |mo, idx| %>
    <% transcription = mo.transcription %>
    <div class="transcription-inline-header">
      <heading><%= t('transcriptions.headings.inline', name: idx + 1) %></heading>
      <span class="transcription-source-subheading"><%= t("transcriptions.source.#{transcription.source}") %></span>
    </div>
    <%# blur the Media Object IF it's sensitive
    Don't bother if the surrounding bookmark is already sensitive.
    %>
    <div class="transcription-div <%= (mo.sensitive && ! bookmark.sensitive) ? "blurred" : ""%>">
      <% if transcription.source == "youtube" %>
        <%= transcription.text.split(/\r?\n/).map do |line|
          if (m = line.match(/\A(\d+\.?\d*)\s+(.*)\z/m))
            %(<span class="youtube-timestamp" data-seconds="#{m[1]}" data-player-id="yt-player-#{mo._id}">#{h(m[1])}</span>#{h(m[2])})
          else
            h(line)
          end
        end.join("<br />\n").html_safe %>
      <% else %>
        <%= transcription.text.split(/\r?\n/).map do |line|
          if (m = line.match(/\A(\d+\.?\d*)\s+(.*)\z/m))
            secs = m[1].to_f
            label = format("%d:%02d", (secs / 60).floor, secs % 60)
            %(<span class="plyr-timestamp" data-seconds="#{m[1]}" data-player-src="#{mo.url}">#{label}</span> #{h(m[2])})
          else
            h(line)
          end
        end.join("<br />\n").html_safe %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% failed_transcriptions = archive.media_objects.select { |mo| mo.transcription&.status == "failed" }.map{|mo| mo.transcription} %>

<% if failed_transcriptions.any? %>
    <div class="transcription-inline-header">
      <heading><%= t('transcriptions.headings.failed_inline', count: failed_transcriptions.size) %></heading>
    </div>
    <% unique_errors = failed_transcriptions.map{|t| t.error}.uniq %>
    <div class="transcription-errors">
      <ul>
        <% unique_errors.each do | error |  %>
          <li><%= error %></ul>
        <% end %>
      </ul>
    </div>
<% end %>
