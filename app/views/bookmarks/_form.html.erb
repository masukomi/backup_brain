<div class="container">
  <%= render partial: 'shared/errors_row', locals: {thing: bookmark} %>
  <%= form_with(model: bookmark) do |form| %>
    <%= hidden_field_tag(:closeable, @closeable) %>
    <%= hidden_field_tag(:referrer, @referrer) %>
    <%= hidden_field_tag(:layout, @layout) %>

    <div class="row">
      <div class="col-2">
        <%= form.label :url, style: "display: block" %>
      </div>
      <div class="col-9">
        <%= form.text_field :url, class: 'bookmark-input-field'  %>
      </div>
    </div>

    <div class="row">
      <div class="col-2">
        <%= form.label :title, style: "display: block" %>
      </div>
      <div class="col-9">
        <%= form.text_field :title, class: 'bookmark-input-field'  %>
      </div>
    </div>

    <div class="row">
      <div class="col-2">
        <%= form.label :description, style: "display: block" %>
      </div>
      <div class="col-9">
        <%= form.text_area :description, class: 'bookmark-textarea-field' %>
        <div style="float: right;"><%== t('misc.markdown_supported_here') %></div>
      </div>
    </div>

    <div class="row safe-space">
      <div class="col-2">
        <%= form.label :tags, style: "display: block" %>
      </div>
      <div class="col-9">
        <div class="tag-input-wrapper bookmark-input-field"
             data-controller="tag-input"
             data-tag-input-autocomplete-url-value="<%= autocomplete_tags_path %>"
             data-action="click->tag-input#focusInput">
          <input type="hidden"
                 name="bookmark[tags]"
                 value="<%= bookmark.tags.join(' ') %>"
                 data-tag-input-target="hidden">
          <div class="tag-chips-area" data-tag-input-target="chipsArea">
            <input type="text"
                   class="tag-text-input"
                   data-tag-input-target="textInput"
                   data-action="keydown->tag-input#handleKeydown input->tag-input#handleInput"
                   autocomplete="off"
                   placeholder="add tags...">
          </div>
          <ul class="dropdown-menu tag-autocomplete-dropdown"
              data-tag-input-target="dropdown"></ul>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-2">
        <%= form.label :private,
            style: "display: block",
            class: "form-check-label",
            for: "privacySwitch"
            %>
      </div>
      <div class="col-1 form-check form-switch">
        <%= inline_icon("private") %>
        <%= form.check_box :private,
            class: 'bookmark-checkbox-field form-check-input toggle',
            role: "switch",
            id: "privacySwitch",
            checked: bookmark.private?
            %>
      </div>
    </div>

    <div class="row">
      <div class="col-2">
        <%= form.label :to_read,
            style: "display: block",
            class: "form-check-label",
            for: "toReadSwitch"
            %>
      </div>
      <div class="col-1 form-check form-switch">
        <%= inline_icon("to_read") %>
        <%= form.check_box :to_read,
            class: 'bookmark-checkbox-field form-check-input toggle',
            role: "switch",
            id: "toReadSwitch",
            checked: bookmark.to_read?
            %>
      </div>
    </div>
    <div class="row">
      <div class="col ">
        <%= form.submit class: "btn btn-primary" %>
      </div>
    </div>

  <% end %>

</div>
