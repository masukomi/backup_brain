<div class="container">
  <% if @note.title.present? %>
    <div class="row">
      <div class="col">
        <div class="archive-text" id="<%= dom_id @note %>-title">
          <%== render_markdown(@note.title) %>
        </div>
      </div>
  </div>
  <% end %>
  <span class="<%= @note.sensitive ? " blurred" : ""%>">
    <div class="row">
      <div class="col">
        <div class="archive-text" id="<%= dom_id @note %>-content">
          <%== render_markdown(@note.string_data.to_s) %>
        </div>
      </div>
    </div>

    <div class="row bookmark-tags-and-date-row">
      <div class="col-9">
        <%= render partial: 'notes/inline_tag_list', locals: {tags: @note.tags} %>
      </div>
      <div class="col bookmark-date-col metadata">
        <%== @note.updated_at.strftime(t('date.formats.default')) %>
      </div>
    </div>
  </span>
</div>
<% content_for :sidebar do %>
  <%= render partial: "shared/sidebar_page_actions_top" %>
  <div id="page-actions">
    <div class="container">
      <div class="row">
        <div class="col">
          <%= link_to t('notes.edit_link'), edit_note_path(@note),
                          class: "btn btn-primary compact-button" %>
        </div>
      </div>
      <% if current_user %>
        <div class="row">
          <div class="col">
            <div class="safe-space">
              <%= button_to t("notes.delete_link"), @note,
                            method: :delete,
                            class: "btn btn-danger compact-button",
                            form: {data: {turbo_confirm: t("misc.are_you_sure")}} %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
