<div class="container">
  <div class="row">
    <div class="col sidebar-tags">
      <% if @query_tags.present? %>
        <div id="tags-list-heading"><%= t('tags.overlapping_tags') %></div>
      <% end %>
      <% @tags_list.each do |tag| %>
        <span class="sidebar-tag">
          <% tags_query_param = get_tags_query_param(tag, @query_tags) %>
          <% if can_add_tag?(tag, @query_tags) %>
            <%= icon_link("add", notes_tagged_with_path(tags: tags_query_param),
                          link_css: "inline-icon-link",
                          icon_css: "add-tag-icon",
                          alt: t('tags.add_tag_to_query'),
                          title: t('tags.add_tag_to_query')
            ) %>
          <% else %>
            <%= icon_link("remove",
                          notes_tagged_with_path(tags: get_tags_query_param_without(tag, @query_tags)),
                          link_css: "inline-icon-link",
                          icon_css: "remove-tag-icon",
                          alt: t('tags.remove_tag_from_query'),
                          title: t('tags.remove_tag_from_query')
            ) %>
          <% end %>
          <%= link_to(tag, notes_tagged_with_path(tags: tag)) %>
        </span>
      <% end %>
    </div>
  </div>
</div>
