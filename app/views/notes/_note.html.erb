<%
non_blank = note.string_data.to_s.lines.reject { |l| l.strip.empty? }
truncated = non_blank.length > 3
preview   = non_blank.first(3).join.strip + "…"
privacy_class = (note.private? ? 'private-note' : '')
sensitive_class = (note.sensitive ? " blurred" : "")
%>
<div tabindex="0" id="<%= dom_id note %>"
     class="container note-list-item <%= privacy_class %>">
  <%# inline flash row %>
  <div class="row">
    <div class="col">
      <% if defined?(inline_flash) %>
        <%= render partial: 'shared/inline_flash',
            locals: {inline_flash: inline_flash} %>
      <% end %>
    </div>
  </div>
  <%# content row %>
  <div class="row">
    <%# everything but action items %>
    <div class="col-8">
      <%# description %>
      <div class="row">
        <div class="col<%= sensitive_class %>" id="<%= dom_id note %>-content">
          <%= link_to note_path(note) do %>
            <%== ::Rendering::Markdown.instance.render(preview) %>
          <% end %>
        </div>
      </div>
    </div> <%# end col-8 main note section%>

    <%#--- action icons -- %>
    <div class="col">
      <div class="action-icons">
        <% if current_user %>
          <div class="action-icon">
            <%== link_to image_tag(
                  '/images/icons/edit.svg',
                  class: 'inline-link-icon edit-link-icon',
                  :"aria-hidden" => true
                ) + t('notes.edit_link'),
                edit_note_path(note),
                class: 'inline-link-icon edit-link-icon'
            %>

          </div>
          <!-- privacy reminder -->
          <% if note.private? %>
            <div class="action-icon">
              <%= inline_icon("private", icon_class: "inline-body-icon") %>
              <span class="private-hint"><%=t('notes.private_hint') %></span>
            </div>
          <% end %>
          <div class="action-icon">
            <%== link_to  image_tag(
              '/images/icons/delete.svg',
              class: 'inline-link-icon delete-icon',
              :"aria-hidden" => true) + t('notes.delete_link'),
            note_path(note, method: :delete),
            class: "inline-link-icon delete-link-icon",
            method: :delete,
            data:   {
              confirm: t('misc.are_your_sure'),
              turbo_method: :delete,
              turbo_confirm: t('misc.are_you_sure')
            }
            %>
          </div>
        <% end %> <%# end requires login %>
      </div><%# end action-icons %>
    </div> <%# end col %>

    <%# tags %>

    <div class="row note-tags-and-date-row">
      <div class="col-9<%= sensitive_class %>">
        <%= render partial: 'notes/inline_tag_list', locals: {tags: note.tags} %>
      </div>
      <div class="col note-date-col metadata">
        <%== note.updated_at.strftime(t('date.formats.default')) %>
      </div>
    </div>

  </div>
</div>
