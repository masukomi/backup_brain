<% if @sites_by_type.any? %>
  <div class="row">
    <div class="col">
      <h2><%= t('oauth2.remote_credentials.authorized_heading') %></h2>
    </div>
  </div>
  <% @sites_by_type.each do |site_type, sites| %>
    <div class="row">
      <div class="col">
        <h4><%= site_type&.name %></h4>
        <ul class="list-unstyled">
          <% sites.each do |site| %>
            <li>
              <%= link_to(site.base_url, site.base_url, target: "_blank") %>
              <span class="text-muted ms-2 small">
                (<%= site.access_token.present? ? t('oauth2.remote_credentials.token_present') : t('oauth2.remote_credentials.token_missing') %>)
              </span>
              <%= button_to t('oauth2.remote_credentials.delete'),
                    remote_credential_path(site),
                    method: :delete,
                    form_class: "inline-button-to",
                    class: "btn btn-sm btn-outline-danger ms-2",
                    data: { turbo: false } %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
<% end %>

<div class="row">
  <div class="col">
    <h2><%= t('oauth2.remote_credentials.heading') %></h2>
  </div>
</div>

<% slug_map = @site_types.each_with_object({}) { |st, h| h[st.id.to_s] = st.slug }.to_json %>

<%= form_with url: begin_remote_auth_path, method: :post, data: { turbo: false, controller: "site-type-fields" } do |f| %>
  <div class="row form-row">
    <div class="col-3">
      <%= f.label :site_type_id, t('oauth2.remote_credentials.site_type_label') %>
    </div>
    <div class="col-6">
      <%= f.select :site_type_id,
            @site_types.map { |st| [st.name, st.id.to_s] },
            { include_blank: false },
            class: "form-select",
            data: {
              site_type_fields_target: "select",
              slug_map: slug_map,
              action: "change->site-type-fields#update"
            } %>
    </div>
  </div>
  <div class="row form-row">
    <div class="col-3">
      <%= f.label :base_url, t('oauth2.remote_credentials.base_url_label') %>
    </div>
    <div class="col-6">
      <%= f.text_field :base_url,
            class: "form-control",
            placeholder: "mastodon.social" %>
    </div>
  </div>
  <div class="row form-row">
    <div class="col-9 metadata">
      <%==  t('oauth2.remote_credentials.base_url_hint') %>
    </div>
  </div>
  <div data-site-type-fields-target="conditional" data-for-slug="bookwyrm">
    <div class="row form-row">
      <div class="col-9 metadata">
        <%== t('oauth2.remote_credentials.bookwyrm_instructions', callback_url: @callback_url) %>
      </div>
    </div>
    <div class="row form-row">
      <div class="col-3">
        <%= f.label :username, t('oauth2.remote_credentials.username_label') %>
      </div>
      <div class="col-6">
        <%= f.text_field :username,
              class: "form-control",
              placeholder: "yourusername" %>
      </div>
    </div>
    <div class="row form-row">
      <div class="col-3">
        <%= f.label :client_id, t('oauth2.remote_credentials.client_id_label') %>
      </div>
      <div class="col-6">
        <%= f.text_field :client_id, class: "form-control" %>
      </div>
    </div>
    <div class="row form-row">
      <div class="col-3">
        <%= f.label :client_secret, t('oauth2.remote_credentials.client_secret_label') %>
      </div>
      <div class="col-6">
        <%= f.text_field :client_secret, class: "form-control" %>
      </div>
    </div>
  </div>
  <div class="row form-row">
    <div class="col">
      <%= f.submit t('oauth2.remote_credentials.submit'), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
