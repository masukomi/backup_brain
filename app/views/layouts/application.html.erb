<!DOCTYPE html>
<!-- application layout -->
<html>
  <head>
    <title>BackupBrain</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      (function() {
        var s = localStorage.getItem("bb-color-scheme");
        if (s) document.documentElement.dataset.colorScheme = s;
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "/css/bootstrap.css" %>
    <%= stylesheet_link_tag "/css/bootstrap-grid.css" %>
    <%= stylesheet_link_tag "/css/bootstrap-reboot.css" %>
    <%= stylesheet_link_tag "/css/bootstrap-utilities.css" %>
    <%= stylesheet_link_tag "/css/bootstrap.rtl.css" %>
    <%= stylesheet_link_tag "/css/timeline.css" %>
    <%= stylesheet_link_tag "/css/bootstrap_docs.css" %>
    <%= stylesheet_link_tag "/css/backup_brain.css?cache_buster=#{SecureRandom.uuid}" %>
    <% bb_theme = cookies[:bb_theme].presence || "default" %>
    <%= stylesheet_link_tag "/css/backup_brain_colors_#{bb_theme}.css?cache_buster=#{SecureRandom.uuid}", id: "color-theme-css" %>
    <%= javascript_include_tag "/js/popper.min.js" %>
    <%= javascript_include_tag "/js/jquery-3.0.0.slim.min.js" %>
    <%= javascript_include_tag "/js/bootstrap.js" %>
    <%= javascript_importmap_tags %>
    <script type="text/javascript">

        $(function () {
            $('[data-toggle="popover"]').popover()
        })
        // $('.popover-dismiss').popover({
        // 	trigger: 'focus'
        // })
    </script>
    <%= yield :head %>
    <link rel="icon" href="/images/icons/logo_32x32.png" sizes="32x32">
    <link rel="icon" href="/images/icons/logo_128x128.png" sizes="128x128">
    <link rel="icon" href="/images/icons/logo_180x180.png" sizes="180x180">
  </head>

  <body>
    <!-- HEADER ROW -->
    <div class="container" id="header">
      <div class="row" id="navigation">
          <div class="col-3 col-sm-3  home-link-col">
            <button class="hamburger-menu-btn d-lg-none"
                    data-bs-toggle="modal"
                    data-bs-target="#hamburger-nav-modal"
                    aria-label="<%= t('navigation.hamburger_menu_open') %>">
              <%= image_tag "/images/icons/hamburger_menu.svg", class: "hamburger-menu-icon", alt: "" %>
            </button>
            <%= icon_link("logo", root_path,
                link_css: "home-nav-icon",
                alt: t('navigation.home_icon_alt'),
                title: t('navigation.home_icon_title'),
                text: t('misc.header_app_name').html_safe
                )%>
          </div>

          <% if Search::Client.instance.enabled? %>
            <div class="col-3 col-sm-9">
                <%= render partial: 'shared/search_form', locals: {
                    query: (@query || '')
                }%>

            </div>
          <% end %>
      </div>
    </div>
      <!-- END HEADER ROW -->
      <!-- START ALERTS -->
    <div class="container" id="alerts">
      <div class="row" id="navigation">
        <div class="col">
          <% flash.each do |type, msg| %>
            <% Array(msg).each do |m| %>
                <div class="alert <%=class_for_flash(type) %>">
                    <%= t("misc.alerts.#{type}") %>: <%== m %>
                </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
      <!-- END ALERTS -->

    <div class="container" id="body-sections">
      <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-9" id="main-body">
          <%= yield %>
        </div>
        <div class="col-12 col-sm-12 col-md-12 col-lg-3" id="side-navigation">
          <span class="d-none">
            d-none
          </span>
          <span class="d-sm-none">
            d-sm-none
          </span>

          <%# future me: the d-none and d-{size}-block are a pair that must
          both be present for display / hiding with the display property
          to work https://getbootstrap.com/docs/5.0/utilities/display/
          %>
          <span class="d-none d-sm-block">
            <%= render partial: 'shared/side_navigation' %>
            <%= yield :sidebar %>

            <% if defined?(@tags_list) && !%w[notes reviews].include?(controller_name) %>
              <%= render partial: 'shared/side_tags' %>
            <% end %>
            <%= render partial: 'shared/side_administration' %>
          </span>
        </div>
      </div>
    </div>
    <!-- FOOTER -->
    <div class="container non-essential" id="footer">
      <% if current_user %>
        <div class="row">
            <div class="col bookmarklet">
                <a href="javascript:url=location.href; if(document.getSelection){selection=document.getSelection();}else{selection='';}; title=document.title; void(open('<%= request.base_url %>/bookmarks/new?url='+encodeURIComponent(url)+'&description='+encodeURIComponent(selection)+'&title='+encodeURIComponent(title)+'&closeable=true&layout=webextension','Backup Brain','toolbar=no,width=800,height=650'));"><%= t('misc.bookmarklet.link_text') %></a> <%== t('misc.bookmarklet.inline_instructions') %>
            </div>
        </div>
      <% end %>

        <div class="row">
            <div class="col version-info">
            <%= t('misc.launched_with_version', version: Rails.configuration.x.git_version) %>
            </div>
        </div>
    </div>
    <!-- HAMBURGER NAV MODAL -->
    <div class="modal fade" id="hamburger-nav-modal" tabindex="-1" role="dialog" aria-label="<%= t('navigation.hamburger_menu_label') %>">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><%= t('navigation.hamburger_menu_label') %></h5>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="<%= t('navigation.hamburger_menu_close') %>"></button>
          </div>
          <div class="modal-body">
            <%= render partial: 'shared/hamburger_nav' %>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
