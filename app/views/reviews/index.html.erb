<% content_for(:sidebar) do %>
  <%= render partial: 'reviews/side_tags' %>
<% end %>

<div class="container">
  <div class="row small-top-margin">
    <div class="col">
      <heading><%= t('reviews.list_heading') %></heading>
    </div>
    <% if current_user %>
      <div class="col-auto">
        <%= link_to t('reviews.add'),
                    new_review_path,
                    class: 'btn btn-primary compact-button' %>
      </div>
    <% end %>
  </div>
</div>

<% if @reviews.empty? %>
  <div class="container">
    <div class="row">
      <div class="col">
        <%= t('reviews.no_reviews_message') %>
      </div>
    </div>
  </div>
<% else %>
  <div class="container small-top-margin" id="reviews">
    <% if !@pagy.nil? && @pagy.count > (@pagy.items * @pagy.page) %>
      <div class="row">
        <div class="col">
          <%= render partial: 'pagy/reviews_db_results', locals: {pagy: @pagy} %>
        </div>
      </div>
    <% end %>

    <% @reviews.each do |review| %>
      <div class="row">
        <div class="col">
          <%= render review %>
        </div>
      </div>
    <% end %>

    <% if !@pagy.nil? && @pagy.count > (@pagy.items * @pagy.page) %>
      <div class="row">
        <div class="col">
          <%= render partial: 'pagy/reviews_db_results', locals: {pagy: @pagy} %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
