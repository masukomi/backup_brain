<div class="container">
  <div class="row">
    <div class="col">
      <ul id="side-nav-items">
        <li data-controller="color-scheme"
            data-color-scheme-dark-label-value="<%= t('navigation.enable_dark_mode') %>"
            data-color-scheme-light-label-value="<%= t('navigation.enable_light_mode') %>">
          <a href="#" data-action="click->color-scheme#toggle">
            <img src="/images/icons/moon.svg" data-color-scheme-target="icon" class="inline-icon">
            <span data-color-scheme-target="label"><%= t('navigation.enable_dark_mode') %></span>
          </a>
        </li>

        <% if ! current_user %>
          <li><span class="learn-more"><a href="https://BackupBrain.app" title="<%= t('misc.learn_more_title')%>"><%==t('misc.learn_more_link')%></a></span></li>
        <% end  %>

        <% if current_user %>
          <li><%= link_to t('dashboards.dailies.sidebar_link'), dailies_path %>
        <% end  %>

        <li><%= link_to t('bookmarks.all_link'), bookmarks_path %>
        <% if current_user %>
          <li><%= link_to t('bookmarks.add'), new_bookmark_path %> </li>
        <% end %>
        <li><%= link_to t('navigation.to_read_link'), bookmarks_to_read_path %></li>
        <li><%= link_to t('notes.list_link'), notes_path %></li>
        <li><%= link_to t('reviews.list_link'), reviews_path %></li>
        <% if current_user %>
        <li><%= link_to t('people.list_link'), people_path %></li>
        <li><%= link_to t('tags.link'), tags_path %></li>
        <li><%= link_to t('navigation.unarchived_link'), bookmarks_unarchived_path %></li>
        <li><%= link_to t('administration.nav_link'), administration_path %></li>
        <% end %>


        <%# WITH LOGGED IN USER %>
        <% if current_user %>
          <li>
            <% if cookies[:hide_private].present? %>
              <%= button_to t('navigation.show_private'), show_private_path, method: :delete, class: "btn btn-small btn-secondary mx-2 compact-button safe-space" %>
            <% else %>
              <%= button_to t('navigation.hide_private'), hide_private_path, method: :post, class: "btn btn-small btn-secondary mx-2 compact-button safe-space" %>
            <% end %>
          </li>
          <li><%= button_to t('accounts.links.sign_out'), destroy_user_session_path, method: :delete, class: "btn btn-small btn-primary mx-2 compact-button safe-space" %></li>
        <%# WITHOUT LOGIN BUT WITH A USER EXISITNG %>
        <% elsif @user_count > 0 %>
          <li><%= link_to t('accounts.links.sign_in'), new_user_session_path, class: "nav-link"  %></li>
        <%# NEW INSTALL NO USER %>
        <% else %>
          <%# for now we're keeping this a single user app ' %>
          <li><%= link_to t('accounts.links.sign_up'), new_user_registration_path, class: "nav-link"  %></li>
        <% end %>

      </ul>
    </div>
  </div>
</div>
