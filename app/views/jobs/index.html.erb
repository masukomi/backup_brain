<div data-controller="auto-refresh">
<div class="row">
  <div class="col">
    <h2><%= t("jobs.heading") %></h2>
  </div>
</div>

<div class="row">
  <div class="col">
    <h3><%= t("jobs.manageable_heading") %></h3>
    <table class="table">
      <thead>
        <tr>
          <th><%= t("jobs.columns.job") %></th>
          <th><%= t("jobs.columns.status") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @jobs.each do |job| %>
          <tr>
            <td><%= job[:label] %></td>
            <td>
              <% running = job[:pending_jobs].find { |j| j.locked_at.present? } %>
              <% scheduled = job[:pending_jobs].reject { |j| j.locked_at.present? } %>
              <% if running %>
                <span class="text-warning"><%= t("jobs.status.running") %></span>
              <% elsif scheduled.size == 1 %>
                <span class="text-success">
                  <%= t("jobs.status.scheduled_at", time: time_ago_in_words(scheduled.first.run_at)) %>
                </span>
              <% elsif scheduled.size > 1 %>
                <span class="text-success">
                  <%= t("jobs.status.scheduled_multiple", count: scheduled.size, time: time_ago_in_words(scheduled.first.run_at)) %>
                </span>
              <% else %>
                <span class="text-muted"><%= t("jobs.status.not_scheduled") %></span>
              <% end %>
            </td>
            <td>
              <% if running %>
                <%= form_with url: abort_job_path(delayed_job_id: running.id),
                              method: :delete,
                              data: { turbo: false } do |f| %>
                  <%= f.submit t("jobs.abort_run"), class: "btn btn-sm btn-danger" %>
                <% end %>
              <% else %>
                <%= form_with url: run_job_path(job_class: job[:class_name]),
                              method: :post,
                              data: { turbo: false } do |f| %>
                  <%= f.submit t("jobs.run_now"), class: "btn btn-sm btn-secondary" %>
                <% end %>
              <% end %>
              <% if job[:pending_jobs].any? %>
                <%= form_with url: unschedule_job_path(job_class: job[:class_name]),
                              method: :delete,
                              data: { turbo: false } do |f| %>
                  <%= f.submit t("jobs.unschedule"), class: "btn btn-sm btn-outline-danger" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="row">
  <div class="col">
    <h3><%= t("jobs.unmanageable_heading") %></h3>
    <table class="table">
      <thead>
        <tr>
          <th><%= t("jobs.columns.job") %></th>
          <th><%= t("jobs.columns.status") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @unmanageable_jobs.each do |job| %>
          <tr>
            <td><%= job[:label] %></td>
            <td>
              <% running = job[:pending_jobs].find { |j| j.locked_at.present? } %>
              <% scheduled = job[:pending_jobs].reject { |j| j.locked_at.present? } %>
              <% if running %>
                <span class="text-warning"><%= t("jobs.status.running") %></span>
              <% elsif scheduled.size == 1 %>
                <span class="text-success">
                  <%= t("jobs.status.scheduled_at", time: time_ago_in_words(scheduled.first.run_at)) %>
                </span>
              <% elsif scheduled.size > 1 %>
                <span class="text-success">
                  <%= t("jobs.status.scheduled_multiple", count: scheduled.size, time: time_ago_in_words(scheduled.first.run_at)) %>
                </span>
              <% else %>
                <span class="text-muted"><%= t("jobs.status.not_scheduled") %></span>
              <% end %>
            </td>
            <td>
              <% if job[:pending_jobs].any? %>
                <%= form_with url: unschedule_job_path(job_class: job[:class_name]),
                              method: :delete,
                              data: { turbo: false } do |f| %>
                  <%= f.submit t("jobs.unschedule"), class: "btn btn-sm btn-outline-danger" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
</div>
