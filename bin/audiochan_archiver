#!/usr/bin/env ruby
# frozen_string_literal: true

# Fetches metadata for an audiochan.com track via their JSON API and writes
# markdown (with an HTML5 <audio> element) to stdout.
#
# Usage: bin/audiochan_archiver <url>
# The URL should be of the form: https://audiochan.com/a/<slug>

require "uri"
require "json"
require "yaml"
require "httparty"
require_relative "../app/lib/backup_brain/request_headers"
require_relative "archive_tool_helper"
include ArchiveToolHelper # rubocop:disable Style/MixinUsage
# error_json_and_exit + success_json_and_exit

abort "Usage: #{$0} <url>" unless ARGV.size == 1

if ARGV.size != 1
  error_json_and_exit(note: "Invalid usage. Takes a single url as its argument", exception: nil)
  exit 1 # can't happen
end

archiver_logger.info("[#{File.basename($0)}] start url=#{ARGV[0]}")
begin
  url = ARGV[0]

  slug = url.match(%r{audiochan\.com/a/([^/?#]+)}i)&.[](1)
  unless slug
    error_json_and_exit(note: "audiochan_archiver: could not extract slug from URL: #{url}",
      exception: nil)
    exit 64 # EX_USAGE - belt and suspenders. Theoretically can't be reached.
  end

  api_uri = "https://api.audiochan.com/audios/slug/#{slug}"

  # Load domain-matched headers from config, then overlay API-required headers.
  # API headers win so Sec-Fetch-* etc. are always correct for a JSON API call.
  request_headers = BackupBrain::RequestHeaders.new
    .headers_for("https://audiochan.com/")
    .merge(
      "Content-Type" => "application/json",
      "Origin" => "https://audiochan.com",
      "Sec-Fetch-Dest" => "empty",
      "Sec-Fetch-Mode" => "cors",
      "Sec-Fetch-Site" => "same-site"
    )

  begin
    response = HTTParty.get(api_uri, verify: false, headers: request_headers)
  rescue => e
    error_json_and_exit(note: "audiochan_archiver: API request failed", exception: e)
    exit 69 # EX_UNAVAILABLE - can't happen
  end

  unless response.code < 400
    error_json_and_exit(note: "audiochan_archiver: API return #{response.code} for #{slug}",
      exception: e)
    exit 75 # EX_TEMPFAIL - can't happen
  end

  begin
    data = JSON.parse(response.body)
  # STDERR.puts("json_data: \n#{data.to_json}")
  rescue JSON::ParserError => e
    error_json_and_exit(note: "audiochan_archiver: could not parse API Response",
      exception: e,
      additional_info: response.body)
    exit 1 # can't happen but also don't have a more specific exit code
  end

  audio_file = data["audioFile"]
  unless audio_file
    error_json_and_exit(note: "audiochan_archiver: no audioFile in API response",
      exception: nil,
      additional_info: JSON.pretty_generate(data))
    # yes, could just send response.body as additional_info BUT
    # their JSON may be ugly

    exit 66 # EX_NO_INPUT I guess? Again, can't happen
  end

  audio_url = audio_file["url"] || audio_file["stream_url"]
  unless audio_url
    error_json_and_exit(note: "audiochan_archiver: no audio URL in API response",
      exception: nil,
      additional_info: JSON.pretty_generate(data))
    # yes, could just send response.body as additional_info BUT
    # their JSON may be ugly

    exit 66 # EX_NO_INPUT I guess? Again, can't happen
  end

  title = data["title"]&.strip

  # rubocop:disable Rails/Blank
  title = slug if title.nil? || title.empty?
  # rubocop:enable Rails/Blank
  #
  # Recursively extract plain text from a ProseMirror/TipTap content node tree.
  def prosemirror_to_text(node)
    return "" unless node.is_a?(Hash)
    return node["text"] || "" if node["type"] == "text"
    return "\n" if node["type"] == "hard_break"

    children_text = Array(node["content"]).map { |child| prosemirror_to_text(child) }.join("")

    case node["type"]
    when "paragraph", "heading", "blockquote"
      stripped = children_text.strip
      stripped.empty? ? "" : "#{stripped}\n\n"
    when "bullet_list", "ordered_list"
      children_text
    when "list_item"
      "- #{children_text.strip}\n"
    else
      children_text
    end
  end

  description = nil
  desc = data["description"]

  if desc.is_a?(Hash)
    raw = prosemirror_to_text(desc).strip
    description = raw unless raw.empty?
  elsif desc.is_a?(String)
    raw = desc.strip
    description = raw unless raw.empty?
  end

  # well isn't this some dark fucking magic
  description ||= begin
    data.dig("description", "content")
    &.[](0)
      &.dig("content")
    &.[](0)
      &.dig("content")
    &.[](0)
    &.[]("text")
  rescue => e
    archiver_logger.warn("[#{File.basename($0)}] could not extract description from nested content: #{e.message}")
    nil
  end

  # rubocop:disable Rails/Pluck
  tags = data.dig("tags").map { |t| t["name"] }&.join(", ")
  # rubocop:enable Rails/Pluck

  ext = File.extname(audio_file["filename"].to_s).downcase
  mime_type = case ext
  when ".mp3"         then "audio/mpeg"
  when ".m4a"         then "audio/mp4"
  when ".ogg", ".oga" then "audio/ogg"
  when ".wav"         then "audio/wav"
  when ".flac"        then "audio/flac"
  when ".opus"        then "audio/ogg; codecs=opus"
  when ".aac"         then "audio/aac"
  else                "audio/*"
  end

  markdown = <<~END
    # #{title}
    <audio id="player" controls>
        <source src="#{audio_url}" type="#{mime_type}" />
    </audio>


    #{description || ""}


    #{(tags && tags.length > 0) ? tags : ""}
  END

  success_json_and_exit(markdown: markdown)
rescue => e
  error_json_and_exit(note: "Unexpected Exception", exception: e)
  exit 75 # EX_TEMPFAIL (I hope) - also can't happen
end
